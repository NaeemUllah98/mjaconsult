# ============================================================
# MJACONSULT — Environment Variables
# Copy this file to ".env" and fill in your own free-tier keys.
# Never commit the real ".env" file.
# ============================================================

# ---- Firebase (free Spark plan) -----------------------------
# Get these from: Firebase Console > Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Cloudinary (free image hosting) ------------------------
# Cloud name: Cloudinary Dashboard
# Upload preset: Settings > Upload > Add upload preset (set Signing Mode = "Unsigned")
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ---- EmailJS (free email reminders) -------------------------
# From: https://dashboard.emailjs.com/
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ---- Google Calendar / Meet (OAuth) -------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth Client ID (Web)
# Enable the "Google Calendar API" for the project.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# ---- App config ---------------------------------------------
# Email address that bootstraps the first Admin account (see README).
VITE_ADMIN_EMAIL=admin@mjaconsult.com
