# MJACONSULT — single-page-app routing for Apache (Hostinger).
# This file is copied into dist/ on `npm run build`, so deep links like
# /patient/appointments resolve to index.html instead of a 404.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Don't rewrite real files or directories (assets, images, etc.).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Everything else → index.html (React Router handles the route client-side).
  RewriteRule ^ index.html [L]
</IfModule>

# Cache hashed assets aggressively; never cache index.html.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|gif|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
